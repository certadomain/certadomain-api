          "domain",
          "created_at",
          "expires_at",
          "result"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "urn:certadomain:problem:<error>"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "error": {
            "type": "string",
            "description": "Stable error code; same value as the last part of type."
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "error"
        ],
        "description": "RFC 9457 problem details."
      },
      "Index": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "openapi": {
            "type": "string"
          },
          "docs": {
            "type": "string"
          },
